# Horus AI Advisor — copia este archivo como .env (no se versiona) y ajusta los valores.
# Ningún valor de este archivo es un secreto real.

# Secreto compartido Laravel -> FastAPI (mínimo 32 caracteres). Sin él, /api/v1/* responde 503.
# Genera uno con:  .venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
HORUS_AI_SERVICE_TOKEN=

# Escucha solo en loopback. Otros valores se rechazan salvo HORUS_AI_ALLOW_NON_LOOPBACK=true.
HORUS_AI_HOST=127.0.0.1
HORUS_AI_PORT=8001

# Catálogo público exportado por Laravel (FUTURO; desactivado: dejar vacío).
# Ver README §13. La clave de firma (>=32 caracteres) la comparten Laravel y este servicio.
HORUS_AI_CATALOG_PATH=
HORUS_AI_CATALOG_SIGNING_KEY=
HORUS_AI_CATALOG_ALLOW_UNSIGNED=false
HORUS_AI_MAX_CATALOG_BYTES=1048576

# Búsqueda semántica opcional (requiere el extra "semantic" y el modelo en models/).
HORUS_AI_SEMANTIC_ENABLED=false
HORUS_AI_SEMANTIC_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HORUS_AI_SEMANTIC_MODEL_DIR=models/paraphrase-multilingual-MiniLM-L12-v2
HORUS_AI_ML_THREADS=2

# Límites
HORUS_AI_MAX_MESSAGE_CHARS=2000
HORUS_AI_MAX_HISTORY_ITEMS=10
HORUS_AI_MAX_BODY_BYTES=32768
HORUS_AI_REQUEST_TIMEOUT_SECONDS=5
HORUS_AI_MAX_CONCURRENT_REQUESTS=4

HORUS_AI_LOG_LEVEL=INFO
