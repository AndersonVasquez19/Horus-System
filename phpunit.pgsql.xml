<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap-pgsql.php" colors="true" cacheResult="false">
    <testsuites>
        <testsuite name="PostgreSQL isolated">
            <directory>tests/Unit</directory>
            <directory>tests/Feature</directory>
            <!-- SQLite por diseño: pruebas de la propia barrera y del comando que opera sobre SQLite. -->
            <exclude>tests/Unit/TestDatabaseSafetyTest.php</exclude>
            <exclude>tests/Unit/ConcurrentTestSessionTest.php</exclude>
            <exclude>tests/Feature/PromoverAdminLocalTest.php</exclude>
        </testsuite>
        <testsuite name="PostgreSQL integrity">
            <directory>tests/PostgresIntegrity</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="HORUS_PG_TEST_PROFILE" value="1" force="true"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
    </php>
</phpunit>
