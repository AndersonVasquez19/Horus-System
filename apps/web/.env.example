# Servidor de Next (nunca NEXT_PUBLIC_*): API publica de Laravel para el BFF (Fase 2).
# URL base de Laravel sin barra final, p. ej. http://127.0.0.1:8000
HORUS_API_URL=
# Mismo valor que HORUS_WEB_SERVICE_TOKEN de apps/api (minimo 32 caracteres). Solo servidor.
HORUS_WEB_SERVICE_TOKEN=

# Base publica (alcanzable desde el navegador) de Laravel para imagenes /assets y /storage. Si se omite se usa HORUS_API_URL.
HORUS_ASSETS_URL=
