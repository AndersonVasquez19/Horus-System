APP_NAME="Horus Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# URL pública de apps/web (Next.js), sin barra final. Las páginas estáticas retiradas de Blade redirigen allí; vacía = 404.
HORUS_WEB_URL=
# Secreto del BFF de apps/web para /api/public/v1/* (minimo 32 caracteres, solo servidor). Vacio = esas rutas dan 404.
HORUS_WEB_SERVICE_TOKEN=
# Obligatorio en producción: al menos 32 bytes aleatorios. Sin él, la clave se deriva de APP_KEY.
JWT_SECRET=
JWT_TTL=900
JWT_LEEWAY=0

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=horus_group
DB_USERNAME=postgres
# Local-development placeholder; use your PostgreSQL password.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción (HTTPS): true. Sin esto la cookie de sesión también viaja por HTTP.
# SESSION_SECURE_COOKIE=true

# IPs de los balanceadores/proxies de confianza, separadas por comas (o *). Vacío = no confiar en ninguno.
# Sin esto, detrás de un proxy todos los limitadores por IP comparten un único cubo.
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Recuperación de contraseña (y otros correos que usan el mailer por defecto): MAIL_MAILER=resend + RESEND_API_KEY envía por Resend.
# El enlace del correo apunta a HORUS_WEB_URL (/restablecer-contrasena). MATRICULA_MAIL_ENABLED es independiente (bienvenida de matrícula).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Logo de los correos. Vacío = APP_URL + /assets/images/email/logo-horus-email.png, y solo si APP_URL es una URL https pública
# (en producción APP_URL debe ser la dirección pública de la API, también en worker y scheduler, que son quienes envían).
# Sin URL pública el correo muestra solo el nombre en texto. Opcional: MAIL_LOGO_URL=https://… para apuntar a otra dirección.
# MAIL_LOGO_URL=

# Bienvenida de matrícula: mantener desactivado hasta verificar dominio y operación.
# No depende de MAIL_MAILER: usa la API HTTPS de Resend con idempotencia.
MATRICULA_MAIL_ENABLED=false
MATRICULA_MAIL_QUEUE_CONNECTION=database
MATRICULA_MAIL_QUEUE=default
RESEND_API_KEY=

# Certificado por correo (aviso con enlace público de verificación, sin adjuntos). Usa el mailer por defecto (MAIL_MAILER=resend) y la cola.
# Apagado por defecto. AUTO=true además lo envía al emitir; con false lo envía el personal con el botón «Enviar por correo».
# Pasos y orden de encendido: docs/runbook-correo-resend.md.
CERTIFICADO_MAIL_ENABLED=false
CERTIFICADO_MAIL_AUTO=false
CERTIFICADO_MAIL_QUEUE=default

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

HORUS_ADVISOR_ENABLED=false
HORUS_ADVISOR_URL=http://127.0.0.1:8001
HORUS_ADVISOR_TOKEN=
HORUS_ADVISOR_SIGNING_KEY=
HORUS_AI_CATALOG_SYNC_ENABLED=false

# Consulta de DNI (JSON.pe, solo servidor). El token nunca sale del backend.
JSONPE_TOKEN=
JSONPE_URL=https://api.json.pe/api/dni

# Operación y mantenimiento automatizado (apagado por defecto).
HORUS_OPS_ENABLED=false
HORUS_OPS_RENEW_CATALOG=false

# Ola 3 — Recordatorios, WhatsApp Cloud, webhooks Resend y seguridad de cuentas (apagado por defecto).
RECORDATORIOS_INTERNOS_ENABLED=false
RECORDATORIOS_MAIL_ENABLED=false
RECORDATORIOS_CUOTAS_DIAS=3
RECORDATORIOS_MENSAJES_HORAS=24
RESEND_WEBHOOK_SECRET=
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_CLOUD_VERSION=v21.0
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_LANG=es_PE
SEGURIDAD_BLOQUEO_INTENTOS=5
SEGURIDAD_BLOQUEO_MINUTOS=15
SEGURIDAD_BLOQUEO_AUTO_ENABLED=false
SEGURIDAD_ALERTAS_LOGIN_ENABLED=false
