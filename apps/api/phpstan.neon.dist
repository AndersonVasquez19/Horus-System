# Análisis estático del backend (Larastan). Requiere larastan/larastan ^3 en require-dev.
# Ejecutar: vendor/bin/phpstan analyse
#
# Sprint 13: nivel 6 en app/, rutas, configuración, arranque y database/.
# Subir de nivel solo corrigiendo las causas, sin baseline ni supresiones masivas.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - routes
        - database
        - config
        - bootstrap/app.php
        - bootstrap/providers.php
    # Larastan infiere las propiedades de los modelos desde las migraciones. Las suspendidas
    # (database/migraciones-suspendidas) siguen describiendo tablas de modelos del código; solo se leen,
    # nunca se ejecutan ni se modifican. Definir esta clave sustituye la ruta predeterminada, así que
    # se repite database/migrations.
    databaseMigrationsPath:
        - database/migrations
        - database/migraciones-suspendidas
    reportUnmatchedIgnoredErrors: true
