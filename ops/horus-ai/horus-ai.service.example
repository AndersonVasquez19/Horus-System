# Plantilla NO instalada. Sin sección Install: no habilitación automática.
[Unit]
Description=Horus AI local - activacion operativa independiente
After=network.target
ConditionPathExists=/etc/horus-ai/OPERATION_AUTHORIZED
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
CPUAccounting=true
MemoryAccounting=true
User=horus-ai
Group=horus-ai
WorkingDirectory=/srv/horus/current/chatbot-python
Environment=HORUS_OPS_ENABLED=false
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/horus-ai/python.conf
ExecStartPre=/srv/horus/current/chatbot-python/.venv/bin/python -m app.operacion check
ExecStart=/srv/horus/current/chatbot-python/.venv/bin/python -m app.operacion run --execute
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/horus-ai/catalog
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
StandardOutput=journal
StandardError=journal
